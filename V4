    local textSize = TextService:GetTextSize(text, 10, Enum.Font.Gotham, Vector2.new(availableWidth - 16, math.huge))
    local totalHeight = math.max(26, textSize.Y + padding)
    
    bubble.Size = UDim2.new(0, availableWidth, 0, totalHeight)
    bubble.Position = isUser and UDim2.new(1, -bubble.AbsoluteSize.X - 4, 0, 0) or UDim2.new(0, 4, 0, 0)
    msgFrame.Size = UDim2.new(1, 0, 0, totalHeight + 6)
    
    ChatScroll.CanvasSize = UDim2.new(0, 0, 0, ChatLayout.AbsoluteContentSize.Y + 10)
    ChatScroll.CanvasPosition = Vector2.new(0, ChatScroll.CanvasSize.Y.Scale * ChatScroll.AbsoluteSize.Y + ChatScroll.CanvasSize.Y.Offset)
    
    if sender == "Moon AI" then
        playSound(4590657391) -- Play notification sound on AI response
        local cleaned = cleanCodeString(text)
        if cleaned:match("game:") or cleaned:match("local%s+") or cleaned:match("function") then
            local execBtn = Instance.new("TextButton", bubble)
            execBtn.Size = UDim2.new(0, 80, 0, 20)
            execBtn.Position = UDim2.new(1, -85, 1, -22)
            execBtn.BackgroundColor3 = Color3.fromRGB(70, 110, 240)
            execBtn.Text = "▶ Execute"
            execBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            execBtn.Font = Enum.Font.GothamBold
            execBtn.TextSize = 9
            Instance.new("UICorner", execBtn).CornerRadius = UDim.new(0, 4)
            
            execBtn.Activated:Connect(function()
                playSound(9060472719)
                local success, err = executeScript(text)
                if success then
                    execBtn.Text = "✔ Executed"
                    execBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 90)
                    task.delay(1.5, function()
                        if execBtn.Parent then
                            execBtn.Text = "▶ Execute"
                            execBtn.BackgroundColor3 = Color3.fromRGB(70, 110, 240)
                        end
                    end)
                else
                    execBtn.Text = "✖ Error"
                    execBtn.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
                    warn("[Moon AI Error]: " .. tostring(err))
                    task.delay(2, function()
                        if execBtn.Parent then
                            execBtn.Text = "▶ Execute"
                            execBtn.BackgroundColor3 = Color3.fromRGB(70, 110, 240)
                        end
                    end)
                end
            end)
        end
    end
end

local function sendToGemini(userPrompt)
    local apiKey = APIInput.Text
    if apiKey == "" then
        appendMessage("System", "Error: API Key is missing. Please enter it in the setup window.")
        return
    end
    
    local systemInstruction = (CustomSystemPromptOverride ~= "") and CustomSystemPromptOverride or DefaultSystemInstruction
    local envContext = scanGameEnvironment()
    local fullPrompt = envContext .. "\n\nUser Request: " .. userPrompt
    
    table.insert(ConversationHistory, {
        role = "user",
        parts = {{ text = fullPrompt }}
    })
    
    if #ConversationHistory > MAX_HISTORY_ENTRIES then
        table.remove(ConversationHistory, 1)
        table.remove(ConversationHistory, 1)
    end
    
    local payload = {
        system_instruction = {
            parts = {{ text = systemInstruction }}
        },
        contents = ConversationHistory
    }
    
    local baseUrl = (CustomBaseURL ~= "") and CustomBaseURL or "https://generativelanguage.googleapis.com/v1beta/"
    local url = baseUrl .. SELECTED_MODEL_PATH .. ":generateContent?key=" .. apiKey
    
    task.spawn(function()
        local success, response = pcall(function()
            return HttpService:JSONEncode(payload)
        end)
        
        if not success then
            appendMessage("System", "JSON Encode Error: " .. tostring(response))
            return
        end
        
        local requestFunc = syn and syn.request or http_request or request or HttpPost
        if not requestFunc then
            appendMessage("System", "Error: Executor does not support HTTP requests.")
            return
        end
        
        local reqSuccess, reqResult = pcall(function()
            return requestFunc({
                Url = url,
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json"
                },
                Body = response
            })
        end)
        
        if not reqSuccess or not reqResult then
            appendMessage("System", "Network Request Failed.")
            return
        end
        
        local decodeSuccess, decoded = pcall(function()
            return HttpService:JSONDecode(reqResult.Body)
        end)
        
        if not decodeSuccess or not decoded then
            appendMessage("System", "JSON Decode Failed.")
            return
        end
        
        if decoded.error then
            appendMessage("Moon AI", "API Error: " .. tostring(decoded.error.message))
            return
        end
        
        if decoded.candidates and decoded.candidates[1] and decoded.candidates[1].content then
            local aiResponseText = decoded.candidates[1].content.parts[1].text
            table.insert(ConversationHistory, {
                role = "model",
                parts = {{ text = aiResponseText }}
            })
            appendMessage("Moon AI", aiResponseText)
        else
            appendMessage("Moon AI", "Received empty response from model.")
        end
    end)
end

