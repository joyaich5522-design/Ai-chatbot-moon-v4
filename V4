local function scanGameEnvironment()
    local scanSummary = {}
    table.insert(scanSummary, "Place ID: " .. tostring(game.PlaceId))
    
    local workspaceItems = {}
    for _, child in ipairs(Workspace:GetChildren()) do
        if #workspaceItems < 8 and not child:IsA("Player") then
            table.insert(workspaceItems, child.Name .. " (" .. child.ClassName .. ")")
        end
    end
    table.insert(scanSummary, "Workspace Snapshot: " .. table.concat(workspaceItems, ", "))
    
    local replicatedStorage = game:GetService("ReplicatedStorage")
    local remotesList = {}
    local function recursiveScan(parent)
        for _, obj in ipairs(parent:GetChildren()) do
            if (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction")) and #remotesList < 6 then
                table.insert(remotesList, obj.Name .. " [" .. obj.ClassName .. "]")
            end
            if #obj:GetChildren() > 0 and #remotesList < 6 then
                recursiveScan(obj)
            end
        end
    end
    pcall(function() recursiveScan(replicatedStorage) end)
    
    if #remotesList > 0 then
        table.insert(scanSummary, "Remotes: " .. table.concat(remotesList, ", "))
    else
        table.insert(scanSummary, "Remotes: None found")
    end
    
    return "[Environment Context]\n- " .. table.concat(scanSummary, "\n- ")
end

local function saveFile(path, content)
    if writefile then pcall(writefile, path, content) end
end

local function loadFile(path)
    if readfile and isfile and isfile(path) then
        local success, result = pcall(readfile, path)
        if success then return result end
    end
    return nil
end

local function copyToClipboard(str)
    if setclipboard then pcall(setclipboard, str) return true end
    if toclipboard then pcall(toclipboard, str) return true end
    if set_clipboard then pcall(set_clipboard, str) return true end
    return false
end

local function cleanCodeString(code)
    code = code:gsub("^%s*```lua%s*", "")
    code = code:gsub("^%s*```%s*", "")
    code = code:gsub("%s*```%s*$", "")
    return code
end

local function executeScript(code)
    local actualCode = cleanCodeString(code)
    local execFunc = loadstring or (syn and syn.loadstring) or (fluxus and fluxus.loadstring)
    if execFunc then
        local compiled, err = execFunc(actualCode)
        if compiled then
            task.spawn(compiled)
            return true, nil
        else
            return false, err
        end
    end
    return false, "Executor does not support loadstring"
end

